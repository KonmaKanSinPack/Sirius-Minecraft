{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "input.click({ button, count, hold_ms? })。spec §8.2；hold_ms 为 M3.5 v1.1 增强。\n\nhold_ms（0..10000）有值时按下→等待→抬起（挖掘式长按）；缺省 = 25ms tap 不变。",
  "properties": {
    "button": {
      "title": "Button",
      "type": "integer"
    },
    "count": {
      "default": 1,
      "minimum": 1,
      "title": "Count",
      "type": "integer"
    },
    "hold_ms": {
      "anyOf": [
        {
          "maximum": 10000,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hold Ms"
    }
  },
  "required": [
    "button"
  ],
  "title": "ClickParams",
  "type": "object"
}
