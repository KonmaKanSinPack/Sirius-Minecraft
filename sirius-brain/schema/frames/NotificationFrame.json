{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Mod → 后端事件推送帧（一等公民，主动唤醒 agent）。spec §8.2。",
  "properties": {
    "type": {
      "const": "notification",
      "default": "notification",
      "title": "Type",
      "type": "string"
    },
    "event": {
      "title": "Event",
      "type": "string"
    },
    "data": {
      "additionalProperties": true,
      "title": "Data",
      "type": "object"
    },
    "timestamp": {
      "title": "Timestamp",
      "type": "number"
    },
    "seq": {
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    }
  },
  "required": [
    "event",
    "timestamp",
    "seq"
  ],
  "title": "NotificationFrame",
  "type": "object"
}
